# 이미지 정보
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
POSTGRES_IMAGE=postgres:16
LITELLM_PORT=4000

# AWS 환경설정
AWS_REGION_NAME=<리전설정>
BEDROCK_MODEL=bedrock/<REPLACE_WITH_BEDROCK_MODEL_OR_PROFILE_ID>
AWS_ROLE_ARN=<AWS ROLE ARN 입력>
AWS_GUARDRAIL_ID=<가드레일 ID 입력>
AWS_MODEL_ID=<추론프로파일 ARN 입력>

# LiteLLM, Postgresql 환경설정
POSTGRES_PASSWORD=<패스워드 입력>
LITELLM_MASTER_KEY='sk.<마스터키 입력>'
LITELLM_SALT_KEY=<솔트키 입력>
UI_PASSWORD=<패스워드 입력>
LITELLM_DB_PASSWORD=<DB패스워드 입력>

DATABASE_URL="postgresql://${POSTGRES_USER:?required}:${POSTGRES_PASSWORD:?required}@postgres:5432/${POSTGRES_DB:?required}"
LITELLM_MASTER_KEY='sk-GANPLANK-LITE-LLM-Master-key-901102-@_@'
LITELLM_SALT_KEY='Ganplank'

UI_PASSWORD='Admin123!'

# SSL CA
SSL_CERT_FILE=<CA 경로 입력>

# 인터넷 검색 툴 by LiteLLM
TAVILY_API_KEY=<TAVILY_API_KEY 입력>
