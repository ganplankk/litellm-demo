# Initial official image tags. pin_images.py replaces these with pulled digests.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
POSTGRES_IMAGE=postgres:16
LITELLM_PORT=4000

# Choose a region and a Claude model / inference profile available to your account.
# Keep the bedrock/ prefix. An inference profile ARN is also accepted by LiteLLM.
AWS_REGION_NAME=ap-northeast-2
BEDROCK_MODEL=bedrock/REPLACE_WITH_BEDROCK_MODEL_OR_PROFILE_ID

# init_env.py generates unique values locally. Do not publish the resulting .env.
POSTGRES_PASSWORD=GENERATE_LOCALLY
LITELLM_MASTER_KEY=GENERATE_LOCALLY
LITELLM_SALT_KEY=GENERATE_LOCALLY
UI_PASSWORD=GENERATE_LOCALLY
